# ═══════════════════════════════════════════════════════════
# GTR v10.1 — .htaccess
# • Скрывает .php в URL (extensionless)
# • Favicon: .ico → .svg (без 404 в консоли)
# • Защита /includes/, /tools/, служебных файлов
# • Security headers + кэш статики
# ═══════════════════════════════════════════════════════════

# ─── Базовые директивы ───
Options -Indexes -MultiViews
DirectoryIndex index.php index.html

# ─── Кодировка по умолчанию ───
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ═══════════════════════════════════════════════════════
    # 1. FAVICON: .ico → .svg (без 404)
    # ═══════════════════════════════════════════════════════
    RewriteRule ^favicon\.ico$ /favicon.svg [L]

    # ═══════════════════════════════════════════════════════
    # 2. БЛОКИРОВКА СЛУЖЕБНЫХ ПАПОК
    # ═══════════════════════════════════════════════════════
    RewriteRule ^(includes|tools)/ - [F,L]

    # ═══════════════════════════════════════════════════════
    # 3. СКРЫВАЕМ .php В URL (301-редирект)
    #    /login.php           → /login
    #    /admin/stats.php     → /admin/stats
    #    /calendar.php        → /calendar
    #    НО /api/*.php НЕ ТРОГАЕМ (fetch() не поймёт редирект)
    # ═══════════════════════════════════════════════════════

    # 3.1. /index.php → / (главная без слэша)
    RewriteRule ^index\.php$ / [L,R=301]

    # 3.2. Остальные .php → без расширения
    # ИСКЛЮЧЕНИЯ: /api/, /includes/, /tools/ — служебные
    #             /proxy.php, /stat.php — утилиты, не должны редиректиться
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+?)\.php(?:\?|\ ) [NC]
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_URI} !^/tools/
    RewriteCond %{REQUEST_URI} !^/proxy\.php$
    RewriteCond %{REQUEST_URI} !^/stat\.php$
    RewriteRule ^(.+)\.php$ /$1 [L,R=302]

    # ═══════════════════════════════════════════════════════
    # 4. EXTENSIONLESS → .php (внутренний, без редиректа)
    #    /login          → /login.php         (сервер видит .php)
    #    /admin/stats    → /admin/stats.php
    #    /register       → /register.php
    #    POST-запросы сохраняются (это внутренний rewrite)
    # ═══════════════════════════════════════════════════════
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [L]

    # ═══════════════════════════════════════════════════════
    # 5. Красивые URL для директорий (если нет index.html)
    #    /admin/  → /admin/stats.php  (не критично, но пусть)
    # ═══════════════════════════════════════════════════════
    # (у тебя такой структуры нет, поэтому закомментировано)
    # RewriteCond %{REQUEST_FILENAME} -d
    # RewriteCond %{REQUEST_FILENAME}/index.php -f
    # RewriteRule ^(.*)$ $1/index.php [L]
</IfModule>

# ═══════════════════════════════════════════════════════════
# 6. ЗАЩИТА ЧУВСТВИТЕЛЬНЫХ ФАЙЛОВ
# ═══════════════════════════════════════════════════════════
<FilesMatch "(^\.env|^\.htaccess|^\.htpasswd|^\.git.*|^composer\.(json|lock)$|^package\.json$|^\.DS_Store$|^Thumbs\.db$)">
    Require all denied
</FilesMatch>

# Запрет на доступ к .sql/.log/.bak напрямую (защита от утечек)
<FilesMatch "\.(sql|log|bak|old|orig|tmp|swp)$">
    Require all denied
</FilesMatch>

# ═══════════════════════════════════════════════════════════
# 7. SECURITY HEADERS
# ═══════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    # Защита от clickjacking (запрет iframe с других сайтов)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Запрет MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer: отправляем только origin на чужие сайты
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions-Policy: чистая, без устаревших features
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Убираем утечку версии PHP (если mod_headers + mod_php)
    Header unset X-Powered-By

    # HSTS — только если ВСЁ работает по HTTPS (раскомментируй когда уверен)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ═══════════════════════════════════════════════════════════
# 8. КЭШИРОВАНИЕ СТАТИКИ
# ═══════════════════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On

    # PHP/HTML — не кэшируем (данные меняются)
    ExpiresByType text/html                "access plus 0 seconds"

    # CSS/JS — 1 час (баланс между производительностью и обновлениями)
    ExpiresByType text/css                 "access plus 1 hour"
    ExpiresByType application/javascript   "access plus 1 hour"
    ExpiresByType text/javascript          "access plus 1 hour"

    # Иконки — 1 день
    ExpiresByType image/svg+xml            "access plus 1 day"
    ExpiresByType image/png                "access plus 1 day"
    ExpiresByType image/jpeg               "access plus 1 day"
    ExpiresByType image/gif                "access plus 1 day"
    ExpiresByType image/x-icon             "access plus 1 day"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 day"

    # Шрифты — 7 дней
    ExpiresByType font/woff                "access plus 7 days"
    ExpiresByType font/woff2               "access plus 7 days"
    ExpiresByType application/font-woff    "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    # Для PHP-файлов — принудительно no-cache (гарантия свежести)
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ═══════════════════════════════════════════════════════════
# 9. СЖАТИЕ (если mod_deflate включён)
# ═══════════════════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/xml text/xml
</IfModule>

# ═══════════════════════════════════════════════════════════
# 10. ОПЦИОНАЛЬНО: HTTPS-редирект (раскомментируй, если нужно)
# ═══════════════════════════════════════════════════════════
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# ═══════════════════════════════════════════════════════════
# 11. PHP-лимиты (для импорта больших JSON)
#     Работает только с mod_php; для PHP-FPM используй .user.ini
# ═══════════════════════════════════════════════════════════
<IfModule mod_php7.c>
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>

<IfModule mod_php8.c>
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>